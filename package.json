{
  "name": "printer-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.cjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:exe": "pkg entry.cjs --config package.json --targets node24-win-x64 --output dist/windows/printer-server.exe && node scripts/windows-gui.cjs",
    "test": "node --test",
    "check": "node --check src/server.js && node --check public/app.js"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "node_modules/.pnpm/@serialport+bindings-cpp@12.0.1/node_modules/@serialport/bindings-cpp/prebuilds/win32-x64/**/*",
      "src/desktop/tray.ps1"
    ]
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "^4.21.2",
    "open": "8.4.2",
    "serialport": "12.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.22.0"
  }
}
