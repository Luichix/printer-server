{
  "name": "printer-server",
  "version": "1.0.3",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.cjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:exe": "node scripts/build-exe.cjs",
    "test": "node --test",
    "check": "node --check src/server.js && node --check public/app.js",
    "build:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -Format Portable",
    "build:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -Format Installer",
    "build:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -Format All"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "node_modules/.pnpm/@serialport+bindings-cpp@12.0.1/node_modules/@serialport/bindings-cpp/prebuilds/win32-x64/**/*",
      "src/desktop/tray.ps1",
      "assets/printer-server.ico"
    ]
  },
  "dependencies": {
    "cors": "2.8.5",
    "escpos-buffer": "^4.1.0",
    "escpos-serialport": "^3.0.0-alpha.4",
    "express": "^4.21.2",
    "node-thermal-printer": "^4.5.0",
    "open": "8.4.2",
    "serialport": "12.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.22.0",
    "resedit": "3.1.0"
  }
}
